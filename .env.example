# Demo is enabled by default. No credentials needed.
EXPO_PUBLIC_DEMO_MODE=true
# Set demo mode to false to start on the real login screen.
# Public client credentials only. Never put service_role keys in an Expo app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Browser-only rehearsal build. Leave false for the normal app.
# npm run build:preview enables this automatically for its generated file.
EXPO_PUBLIC_BROWSER_PREVIEW=false
