# Server-side only. Copy to .env.local, which is ignored. Never use EXPO_PUBLIC_
# for these values. Supabase injects SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY.
# Begin with Stripe test credentials and keep disabled until integration checks pass.
PAYMENTS_ENABLED=false
APP_URL=https://your-splitcart-app.example
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional, server-controlled monthly app dues in cents; 0 disables app payments.
APP_DUES_CENTS=0
PAYMENT_JOB_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
