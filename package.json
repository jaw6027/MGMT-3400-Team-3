{
  "name": "splitcart",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --host lan",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/documents-database.test.ts src/subscriptions-database.test.ts src/external-payments-database.test.ts src/grocery-database.test.ts src/developer-business-database.test.ts src/receipts-database.test.ts src/percentageSplit-database.test.ts src/splitTemplates-database.test.ts src/installments-database.test.ts src/database.test.ts src/households-database.test.ts src/payments-database.test.ts src/paymentSafety-database.test.ts src/shopping-database.test.ts src/chores-database.test.ts",
    "build:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "format": "prettier --write App.tsx src e2e *.ts *.json",
    "test:e2e:households": "playwright test --config playwright.households.config.ts",
    "build:preview": "node scripts/build-browser-preview.mjs",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.89.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-local-authentication": "~17.0.7",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.0",
    "@types/react": "~19.1.10",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
